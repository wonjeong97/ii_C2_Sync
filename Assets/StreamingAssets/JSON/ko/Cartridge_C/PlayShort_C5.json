        "fontSize": 37,
        "fontColor": { "r": 1, "g": 1, "b": 1, "a": 1 },
        "alignment": 1
      }
    },
    {
      "page1": {
        "name": "Text_Question10",
        "position": { "x": 0, "y": 144 },
        "scale": { "x": 1, "y": 1, "z": 1 },
        "text": "의견 차이나 어긋남이 생기면\n시간이 지나면서 괜찮아지길\n기다리는 편이다.",
