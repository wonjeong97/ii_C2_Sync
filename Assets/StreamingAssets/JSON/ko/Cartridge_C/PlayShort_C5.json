        "fontSize": 43,
        "fontColor": { "r": 1, "g": 1, "b": 1, "a": 1 },
        "alignment": 1
      },
      "page2": {
        "name": "Text_Question7",
        "position": { "x": 0, "y": 100 },
        "scale": { "x": 1, "y": 1, "z": 1 },
        "text": "상대의 행동으로 불편함이 생기면,\n마음에 담아두기보다 대화로 표현한다.",
        "fontName": "font7",
        "fontSize": 37,
        "fontColor": { "r": 1, "g": 1, "b": 1, "a": 1 },
        "alignment": 1
      }
    },
    {
